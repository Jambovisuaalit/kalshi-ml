# Buyer defaults: PAPER trading against the PUBLIC PRODUCTION order book.
# Never share .env, private keys, journal files, Telegram tokens or webhooks.
# For real orders set all three: ENV=PROD, TRADING_MODE=live, LIVE_ENABLED=true.
# API credentials are not required for paper mode.
KALSHI_ENV=PROD
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi-prod.pem
KALSHI_TRADING_MODE=paper
KALSHI_LIVE_TRADING_ENABLED=false
KALSHI_SUBACCOUNT=0
KALSHI_EXCHANGE_INDEX=2

STRATEGY_ENTRY_MIN_REMAINING_SEC=180
STRATEGY_ENTRY_MAX_REMAINING_SEC=800
STRATEGY_YES_PROBABILITY_MIN=0.55
STRATEGY_NO_PROBABILITY_MAX=0.45
STRATEGY_MINIMUM_DELTA_USD=5.0
STRATEGY_ENTRY_MIN_CENTS=45
STRATEGY_ENTRY_MAX_CENTS=66
STRATEGY_TAKE_PROFIT_CENTS=88
STRATEGY_HARD_STOP_CENTS=14

MARKET_POLL_SEC=1.0
POSITION_POLL_SEC=0.5
HTTP_TIMEOUT_SEC=10.0
HTTP_MAX_RETRIES=3

# Optional outbound trade-event summaries. Disabled means NO messages sent.
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
